{
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "author": "akasaka",
  "version": "1.3.1",
  "manifest_version": 3,
  "default_locale": "ja",
  "icons": {
    "16": "icons/16.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/title-slot.js", "src/script.js"],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "commands": {
    "screenshot": {
      "description": "__MSG_screenshot__"
    },
    "backward-1000": {
      "description": "__MSG_seekBack1s__"
    },
    "backward-100": {
      "description": "__MSG_seekBack01s__"
    },
    "backward-1f": {
      "description": "__MSG_seekBack1f__"
    },
    "forward-1f": {
      "description": "__MSG_seekForward1f__"
    },
    "forward-100": {
      "description": "__MSG_seekForward01s__"
    },
    "forward-1000": {
      "description": "__MSG_seekForward1s__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubescreenshot@ydk.vc",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
